{
  "name": "hackathon-template",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "predev": "bash scripts/ensure-db.sh && prisma migrate deploy",
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint:prisma": "prisma-lint",
    "lint:secrets": "gitleaks detect --no-banner --redact -c .gitleaks.toml",
    "typecheck": "tsc --noEmit",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:studio": "prisma studio",
    "prisma:deploy": "prisma migrate deploy",
    "prisma:seed": "prisma db seed",
    "test": "vitest run --passWithNoTests",
    "test:watch": "vitest",
    "prepare": "simple-git-hooks"
  },
  "simple-git-hooks": {
    "pre-commit": "npx lint-staged && (command -v gitleaks >/dev/null 2>&1 && gitleaks protect --staged --no-banner --redact -c .gitleaks.toml || echo 'gitleaks not installed — skipping secret scan (install: brew install gitleaks)')"
  },
  "lint-staged": {
    "*.{ts,tsx,mts,mjs,js,jsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,css,md,yml,yaml}": [
      "prettier --write"
    ],
    "prisma/schema.prisma": [
      "prisma-lint"
    ]
  },
  "dependencies": {
    "@astryxdesign/cli": "^0.1.8",
    "@astryxdesign/core": "^0.1.8",
    "@astryxdesign/theme-neutral": "^0.1.8",
    "@auth/prisma-adapter": "^2.11.3",
    "@logtape/logtape": "^2.2.4",
    "@logtape/pretty": "^2.2.4",
    "@logtape/redaction": "^2.2.4",
    "@prisma/adapter-pg": "^7.9.0",
    "@prisma/client": "^7.9.0",
    "clsx": "^2.1.1",
    "effect": "^3.22.0",
    "lucide-react": "^1.26.0",
    "next": "^16.2.11",
    "next-auth": "^5.0.0-beta.25",
    "pg": "^8.22.0",
    "prisma": "^7.9.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "tailwind-merge": "^3.6.0",
    "zod": "^4.4.3"
  },
  "optionalDependencies": {
    "lightningcss-linux-arm64-gnu": "1.33.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@total-typescript/ts-reset": "^0.6.1",
    "@types/node": "^26.1.1",
    "@types/pg": "^8.20.0",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.4",
    "eslint": "^9.39.4",
    "eslint-config-next": "^16.2.11",
    "eslint-config-prettier": "^10.1.8",
    "jsdom": "^29.1.1",
    "lint-staged": "^17.2.0",
    "prettier": "^3.9.6",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "prisma-lint": "^0.13.1",
    "simple-git-hooks": "^2.13.1",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.1",
    "typescript": "6.0.3",
    "vitest": "^4.1.10",
    "zod-prisma-types": "^3.3.11"
  },
  "allowScripts": {
    "@prisma/engines@7.8.0": true,
    "prisma@7.8.0": true,
    "esbuild@0.28.1": true,
    "sharp@0.34.5": true,
    "unrs-resolver@1.11.1": true,
    "fsevents@2.3.3": true,
    "simple-git-hooks": true
  }
}
