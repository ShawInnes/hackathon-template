{
  "name": "hackathon-template",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "predev": "bash scripts/ensure-db.sh && prisma migrate deploy",
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "worker": "tsx --env-file-if-exists=.env --env-file-if-exists=.env.local worker/index.ts",
    "worker:dev": "tsx watch --env-file-if-exists=.env --env-file-if-exists=.env.local worker/index.ts",
    "lint": "eslint",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint:prisma": "prisma-lint",
    "lint:secrets": "gitleaks detect --no-banner --redact -c .gitleaks.toml",
    "typecheck": "tsc --noEmit",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:studio": "prisma studio",
    "prisma:deploy": "prisma migrate deploy",
    "prisma:seed": "prisma db seed",
    "test": "vitest run --passWithNoTests",
    "test:watch": "vitest",
    "prepare": "simple-git-hooks"
  },
  "simple-git-hooks": {
    "pre-commit": "npx lint-staged && (command -v gitleaks >/dev/null 2>&1 && gitleaks protect --staged --no-banner --redact -c .gitleaks.toml || echo 'gitleaks not installed — skipping secret scan (install: brew install gitleaks)')"
  },
  "lint-staged": {
    "*.{ts,tsx,mts,mjs,js,jsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,css,md,yml,yaml}": [
      "prettier --write"
    ],
    "prisma/schema.prisma": [
      "prisma-lint"
    ]
  },
  "dependencies": {
    "@astryxdesign/cli": "^0.7.13",
    "@astryxdesign/core": "^0.7.13",
    "@astryxdesign/theme-neutral": "^0.7.13",
    "@auth/prisma-adapter": "^2.11.3",
    "@logtape/logtape": "^2.4.2",
    "@logtape/pretty": "^2.4.2",
    "@logtape/redaction": "^2.4.2",
    "@prisma/adapter-pg": "^7.10.1",
    "@prisma/client": "^7.10.1",
    "clsx": "^2.1.1",
    "effect": "^4.1.4",
    "graphile-worker": "^0.18.0",
    "lucide-react": "^1.72.0",
    "motion": "^14.12.0",
    "next": "^16.4.6",
    "next-auth": "^5.0.0-beta.25",
    "pg": "^8.23.1",
    "prisma": "^7.10.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tailwind-merge": "^3.7.0",
    "zod": "^4.6.7"
  },
  "optionalDependencies": {
    "lightningcss-linux-arm64-gnu": "1.33.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.5",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.9",
    "@total-typescript/ts-reset": "^0.6.1",
    "@types/node": "^26.6.6",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "eslint": "^10.14.0",
    "eslint-config-next": "^16.4.6",
    "eslint-config-prettier": "^10.1.8",
    "jsdom": "^31.0.0",
    "lint-staged": "^17.6.0",
    "prettier": "^3.9.10",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "prisma-lint": "^0.13.1",
    "simple-git-hooks": "^2.14.0",
    "tailwindcss": "^4.3.5",
    "tsx": "^4.23.15",
    "typescript": "7.0.2",
    "vitest": "^5.1.0",
    "zod-prisma-types": "^3.3.11"
  },
  "allowScripts": {
    "@prisma/engines@7.8.0": true,
    "prisma@7.8.0": true,
    "esbuild@0.28.1": true,
    "sharp@0.34.5": true,
    "unrs-resolver@1.11.1": true,
    "fsevents@2.3.3": true,
    "simple-git-hooks": true
  }
}
